# Copy to .env in the project root (and optionally server/.env)

# PostgreSQL — local dev uses plain TCP, no SSL. Leave PGSSL unset.
# If you use `docker compose up -d` from this repo, this URL works as-is.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/photocopy

# API
PORT=3001
CLIENT_URL=http://localhost:5173

# Optional: require SSL for hosted Postgres (e.g. Neon, RDS)
# PGSSL=true
# PGSSL_REJECT_UNAUTHORIZED=false

# SMTP (Nodemailer) — required to send admin + user emails
# Brevo: see docs/BREVO-SMTP.md — typically:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<email shown on Brevo SMTP settings page>
# SMTP_PASS=<SMTP key from Brevo, not your account password>
# SMTP_FROM="Photocopy <verified-sender@yourdomain.com>"
# SMTP_REQUIRE_TLS=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin notification recipient
ADMIN_EMAIL=savolekovic15@gmail.com

# Optional: protect GET/PATCH/DELETE /api/orders — send header X-Admin-Secret with this value from the Orders page
# ADMIN_SECRET=your-long-random-string

# Optional: pre-fill admin secret in dev only (same as ADMIN_SECRET); never commit real secrets
# VITE_ADMIN_SECRET=

# Frontend (production / non-proxy): full API origin
# VITE_API_URL=http://localhost:3001
