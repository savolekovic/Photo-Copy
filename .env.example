# Copy to .env in the project root (and optionally server/.env)

# PostgreSQL — local dev uses plain TCP, no SSL. Leave PGSSL unset.
# If you use `docker compose up -d` from this repo, this URL works as-is.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/photocopy

# API
PORT=3001
# Also the origin used to build magic-link URLs, so it must match where the
# frontend is actually served.
CLIENT_URL=http://localhost:5173

# Optional: require SSL for hosted Postgres (e.g. Neon, RDS)
# PGSSL=true
# PGSSL_REJECT_UNAUTHORIZED=false

# ---------------------------------------------------------------- SMTP ----
# Required for login links to be delivered. Without SMTP the app still runs and
# the login link is printed to the SERVER CONSOLE instead (development only).
# Brevo: see docs/BREVO-SMTP.md — typically:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<email shown on Brevo SMTP settings page>
# SMTP_PASS=<SMTP key from Brevo, not your account password>
# SMTP_FROM="Photocopy <verified-sender@yourdomain.com>"
# SMTP_REQUIRE_TLS=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Where the "new order" operator notification is sent. If unset, that notification
# is skipped (the student's own confirmation is unaffected).
ADMIN_EMAIL=

# ------------------------------------------------------- Authentication ----
# Domains a student may self-register from, comma separated, without the "@".
STUDENT_EMAIL_DOMAINS=udg.edu.me
# Accept faculty subdomains too, e.g. ime@fmefb.udg.edu.me for udg.edu.me.
STUDENT_EMAIL_ALLOW_SUBDOMAINS=true
# Shown in the sign-in hint on the frontend. Keep in step with the value above.
VITE_STUDENT_EMAIL_DOMAINS=udg.edu.me

# Require a broj indeksa when a student registers.
REQUIRE_INDEX_NUMBER=true

# Magic-link validity and per-address rate limit.
MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_MAX_PER_WINDOW=5
MAGIC_LINK_WINDOW_MINUTES=15

# Session lifetime and cookie name.
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=photocopy_sid
# MUST be true in production (requires HTTPS). Left false so http://localhost works.
COOKIE_SECURE=false
# Proxy hops in front of the API, so req.ip is the real client for rate limiting.
TRUST_PROXY_HOPS=1

# ------------------------------------------------------------ Lifecycle ----
# Days after an order is marked "spremno" before the pickup deadline lapses.
PICKUP_DEADLINE_DAYS=7
# Minimum gap between pickup reminder e-mails.
REMINDER_INTERVAL_HOURS=24

# Default interface/e-mail language: sr-ME or en
DEFAULT_LOCALE=sr-ME

# Frontend (production / non-proxy): full API origin
# VITE_API_URL=http://localhost:3001
